-- 01. CLIENTE
CREATE TABLE cliente (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    telefono VARCHAR(20),
    correo VARCHAR(120)
) ENGINE=InnoDB;

-- 02. TIPO_EQUIPO
CREATE TABLE tipo_equipo (
    id_tipo_equipo INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(60) NOT NULL UNIQUE
) ENGINE=InnoDB;

-- 03. MARCA
CREATE TABLE marca (
    id_marca INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(70) NOT NULL UNIQUE
) ENGINE=InnoDB;

-- 04. TECNICO
CREATE TABLE tecnico (
    id_tecnico INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    especialidad VARCHAR(100) NOT NULL,
    telefono VARCHAR(20)
) ENGINE=InnoDB;

-- 05. TIPO_SERVICIO
CREATE TABLE tipo_servicio (
    id_tipo_servicio INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion VARCHAR(255)
) ENGINE=InnoDB;

-- 06. ESTADO_ORDEN
CREATE TABLE estado_orden (
    id_estado INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE
) ENGINE=InnoDB;

-- 07. PROVEEDOR: empresas que proveen componentes.
CREATE TABLE proveedor (
    id_proveedor INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    telefono VARCHAR(20),
    correo VARCHAR(120)
) ENGINE=InnoDB;

-- 08. EQUIPO: cada equipo pertenece a un cliente y tiene un tipo.
CREATE TABLE equipo (
    id_equipo INT AUTO_INCREMENT PRIMARY KEY,
    id_cliente INT NOT NULL,
    id_tipo_equipo INT NOT NULL,
    id_marca INT,
    modelo VARCHAR(100),
    numero_serie VARCHAR(100) UNIQUE,
    observaciones VARCHAR(255),
    CONSTRAINT fk_equipo_cliente FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),
    CONSTRAINT fk_equipo_tipo FOREIGN KEY (id_tipo_equipo) REFERENCES tipo_equipo(id_tipo_equipo),
    CONSTRAINT fk_equipo_marca FOREIGN KEY (id_marca) REFERENCES marca(id_marca)
) ENGINE=InnoDB;

-- 09. REPUESTO: inventario de componentes, asociados a un proveedor.
CREATE TABLE repuesto (
    id_repuesto INT AUTO_INCREMENT PRIMARY KEY,
    id_proveedor INT NOT NULL,
    nombre VARCHAR(120) NOT NULL,
    descripcion VARCHAR(255),
    stock INT NOT NULL DEFAULT 0,
    precio_unitario DECIMAL(10,2) NOT NULL,
    CONSTRAINT fk_repuesto_proveedor FOREIGN KEY (id_proveedor) REFERENCES proveedor(id_proveedor),
    CONSTRAINT ck_repuesto_stock CHECK (stock >= 0),
    CONSTRAINT ck_repuesto_precio CHECK (precio_unitario >= 0)
) ENGINE=InnoDB;

-- 10. ORDEN_SERVICIO: una reparacion para un equipo, atendida por un tecnico.
CREATE TABLE orden_servicio (
    id_orden INT AUTO_INCREMENT PRIMARY KEY,
    id_equipo INT NOT NULL,
    id_tecnico INT NOT NULL,
    id_estado INT NOT NULL,
    fecha_ingreso DATE NOT NULL,
    problema_reportado VARCHAR(500) NOT NULL,
    fecha_entrega DATE,
    costo_estimado DECIMAL(10,2),
    costo_final DECIMAL(10,2),
    observaciones VARCHAR(255),
    CONSTRAINT fk_orden_equipo FOREIGN KEY (id_equipo) REFERENCES equipo(id_equipo),
    CONSTRAINT fk_orden_tecnico FOREIGN KEY (id_tecnico) REFERENCES tecnico(id_tecnico),
    CONSTRAINT fk_orden_estado FOREIGN KEY (id_estado) REFERENCES estado_orden(id_estado),
    CONSTRAINT ck_orden_fechas CHECK (fecha_entrega IS NULL OR fecha_entrega >= fecha_ingreso),
    CONSTRAINT ck_orden_estimado CHECK (costo_estimado IS NULL OR costo_estimado >= 0),
    CONSTRAINT ck_orden_final CHECK (costo_final IS NULL OR costo_final >= 0)
) ENGINE=InnoDB;

-- 11. HISTORIAL_ESTADO: cada cambio de estado de una orden.
CREATE TABLE historial_estado (
    id_historial INT AUTO_INCREMENT PRIMARY KEY,
    id_orden INT NOT NULL,
    id_estado INT NOT NULL,
    fecha_cambio DATETIME NOT NULL,
    observacion VARCHAR(255),
    CONSTRAINT fk_historial_orden FOREIGN KEY (id_orden) REFERENCES orden_servicio(id_orden),
    CONSTRAINT fk_historial_estado FOREIGN KEY (id_estado) REFERENCES estado_orden(id_estado)
) ENGINE=InnoDB;

-- 12. DIAGNOSTICO: a lo sumo un diagnostico principal por orden.
CREATE TABLE diagnostico (
    id_diagnostico INT AUTO_INCREMENT PRIMARY KEY,
    id_orden INT NOT NULL UNIQUE,
    id_tecnico INT NOT NULL,
    fecha_diagnostico DATE NOT NULL,
    descripcion VARCHAR(500) NOT NULL,
    solucion_recomendada VARCHAR(500),
    CONSTRAINT fk_diagnostico_orden FOREIGN KEY (id_orden) REFERENCES orden_servicio(id_orden),
    CONSTRAINT fk_diagnostico_tecnico FOREIGN KEY (id_tecnico) REFERENCES tecnico(id_tecnico)
) ENGINE=InnoDB;

-- 13. DETALLE_SERVICIO: servicios realizados en cada orden (relacion N:M).
CREATE TABLE detalle_servicio (
    id_detalle INT AUTO_INCREMENT PRIMARY KEY,
    id_orden INT NOT NULL,
    id_tipo_servicio INT NOT NULL,
    cantidad INT NOT NULL DEFAULT 1,
    precio_unitario DECIMAL(10,2) NOT NULL,
    descripcion VARCHAR(255),
    CONSTRAINT fk_detalle_orden FOREIGN KEY (id_orden) REFERENCES orden_servicio(id_orden),
    CONSTRAINT fk_detalle_tipo FOREIGN KEY (id_tipo_servicio) REFERENCES tipo_servicio(id_tipo_servicio),
    CONSTRAINT ck_detalle_cantidad CHECK (cantidad > 0),
    CONSTRAINT ck_detalle_precio CHECK (precio_unitario >= 0)
) ENGINE=InnoDB;

-- 14. REPUESTO_UTILIZADO: piezas consumidas por reparacion (relacion N:M).
CREATE TABLE repuesto_utilizado (
    id_uso INT AUTO_INCREMENT PRIMARY KEY,
    id_orden INT NOT NULL,
    id_repuesto INT NOT NULL,
    cantidad INT NOT NULL,
    precio_unitario DECIMAL(10,2) NOT NULL,
    CONSTRAINT fk_uso_orden FOREIGN KEY (id_orden) REFERENCES orden_servicio(id_orden),
    CONSTRAINT fk_uso_repuesto FOREIGN KEY (id_repuesto) REFERENCES repuesto(id_repuesto),
    CONSTRAINT uq_uso_orden_repuesto UNIQUE (id_orden, id_repuesto),
    CONSTRAINT ck_uso_cantidad CHECK (cantidad > 0),
    CONSTRAINT ck_uso_precio CHECK (precio_unitario >= 0)
) ENGINE=InnoDB;














-- Indices adicionales para filtros y JOIN frecuentes.
CREATE INDEX idx_equipo_cliente ON equipo(id_cliente);
CREATE INDEX idx_orden_equipo_fecha ON orden_servicio(id_equipo, fecha_ingreso);
CREATE INDEX idx_orden_tecnico ON orden_servicio(id_tecnico);
CREATE INDEX idx_orden_estado ON orden_servicio(id_estado);
CREATE INDEX idx_historial_orden_fecha ON historial_estado(id_orden, fecha_cambio);
CREATE INDEX idx_detalle_orden ON detalle_servicio(id_orden);
CREATE INDEX idx_uso_repuesto ON repuesto_utilizado(id_repuesto);
CREATE INDEX idx_repuesto_proveedor ON repuesto(id_proveedor);
